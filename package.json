{
  "name": "chat-app-mwd",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.js",
    "ng": "ng",
    "start": "ng serve",
    "start:server": "tsx server/index.ts",
    "start:server:build": "node dist/server/index.js",
    "start:build": "pnpm run start:server:build",
    "build": "pnpm run build:server && pnpm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "demo": "tsx demo.ts",
    "typecheck": "pnpm run typecheck:server && ng build --configuration development",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "express": "^5.3.0",
    "ws": "^8.23.0",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
